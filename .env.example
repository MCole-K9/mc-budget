# PocketBase Configuration
# Default for local dev: http://127.0.0.1:8090
# In Docker this is set automatically via build args — no need to change it
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser credentials
# Used by the SvelteKit app for admin DB access, and by the Docker entrypoint to create the superuser
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Encryption key for AI API keys stored in the database (AES-256-GCM, 32 bytes, base64).
# Required to save AI keys. Generate one with: openssl rand -base64 32
# Keep it safe: if you lose or change it, saved AI keys must be entered again.
SECRETS_KEY=

# Anthropic API key — fallback for receipt scanning (users can also set their own in Settings)
ANTHROPIC_API_KEY=

# SvelteKit body size limit — increase for receipt file uploads (default: 512K)
BODY_SIZE_LIMIT=2M

# Email forwarding for bank alerts (optional). Both must be set, or forwarding stays off.
# INBOUND_EMAIL_DOMAIN: the domain whose catch-all goes to workers/inbound-email (e.g. in.example.com)
# INBOUND_EMAIL_SECRET: shared with the Worker; generate with: openssl rand -base64 32
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
